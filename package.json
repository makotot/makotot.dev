{
  "name": "makotot.dev",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "style:generate": "panda codegen",
    "dev:content": "velite --watch",
    "build:content": "velite --clean",
    "dev:next": "next dev --turbopack",
    "build:next": "next build",
    "dev": "pnpm run style:generate && run-p dev:*",
    "build": "pnpm run style:generate && run-s build:*",
    "start": "next start",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint .",
    "lint": "run-s lint:*",
    "tsc": "tsc",
    "format:check": "oxfmt --check .",
    "format:write": "oxfmt --write .",
    "test:unit": "vitest run --project=unit",
    "test:unit:coverage": "vitest run --project=unit --coverage",
    "test:storybook": "vitest run --project=storybook",
    "test:storybook:coverage": "vitest run --project=storybook --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@shikijs/rehype": "4.4.3",
    "@shikijs/transformers": "4.4.3",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-aria-components": "1.21.1",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0",
    "rss-parser": "3.13.0",
    "shiki": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.39.5",
    "@pandacss/dev": "1.12.1",
    "@pandacss/eslint-plugin": "0.3.2",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-onboarding": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/nextjs-vite": "10.6.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/eslint-plugin": "1.6.27",
    "babel-plugin-react-compiler": "19.1.0-rc.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-oxlint": "1.82.0",
    "eslint-plugin-storybook": "10.6.0",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "pandacss-preset-typography": "0.1.6",
    "playwright": "1.63.0",
    "postcss": "8.5.28",
    "storybook": "10.6.0",
    "typescript": "6.0.3",
    "velite": "0.4.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.26.0"
}
